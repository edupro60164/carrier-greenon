# Render 또는 로컬 .env에 입력할 공개 클라이언트 설정입니다.
# service_role, secret key, 데이터베이스 비밀번호는 절대로 추가하지 마세요.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Open-Meteo는 기본 비상업 API 사용 시 별도 API 키가 필요하지 않습니다.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LOCATION_NAME=서울
WEATHER_LATITUDE=37.5665
WEATHER_LONGITUDE=126.9780
WEATHER_TIMEZONE=Asia/Seoul

# Render가 PORT를 자동 설정하므로 로컬 개발에서만 필요합니다.
PORT=10000
